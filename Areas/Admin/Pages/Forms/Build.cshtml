@page "{id:int}"
@model Ufas1Forms.Areas.Admin.Pages.Forms.BuildModel
@using Ufas1Forms.Models
@using System.Text.Json
@{
    ViewData["Title"] = $"Build Form: {Model.Form.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Form.Title</h1>
        <p class="text-muted mb-0">Build your form by adding and organizing fields</p>
    </div>
    <div>
        <a asp-page="Edit" asp-route-id="@Model.Form.Id" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Edit
        </a>
        <button type="button" class="btn btn-primary" id="btnAddField">
            <i class="bi bi-plus-lg me-1"></i>Add Field
        </button>
    </div>
</div>

@if (!Model.Fields.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No fields yet. Click "Add Field" to create your first field.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 60px;">Order</th>
                    <th>Label</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Parent</th>
                    <th style="width: 80px;">Required</th>
                    <th style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var field in Model.Fields)
                {
                    var fieldJson = JsonSerializer.Serialize(new
                    {
                        field.Id,
                        field.Label,
                        FieldType = field.FieldType.ToString(),
                        field.HelpText,
                        field.Placeholder,
                        field.DefaultValue,
                        field.IsRequired,
                        field.OptionsJson,
                        field.ParentFieldId
                    });
                    <tr>
                        <td>@field.Order</td>
                        <td><strong>@field.Label</strong></td>
                        <td><code>@field.Name</code></td>
                        <td><span class="badge bg-secondary">@field.FieldType</span></td>
                        <td>
                            @if (field.ParentFieldId.HasValue)
                            {
                                var parent = Model.Fields.FirstOrDefault(f => f.Id == field.ParentFieldId);
                                <span class="badge bg-info">@(parent?.Label ?? "Unknown")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (field.IsRequired)
                            {
                                <span class="badge bg-danger">Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary btn-edit-field" title="Edit"
                                        data-field='@Html.Raw(fieldJson)'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="MoveUp" asp-route-id="@Model.Form.Id" asp-route-fieldId="@field.Id" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary" title="Move Up" @(field == Model.Fields.First() ? "disabled" : "")>
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="MoveDown" asp-route-id="@Model.Form.Id" asp-route-fieldId="@field.Id" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary" title="Move Down" @(field == Model.Fields.Last() ? "disabled" : "")>
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </form>
                                <button type="button" class="btn btn-outline-danger btn-delete-field" title="Delete"
                                        data-field-id="@field.Id" data-field-label="@field.Label">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Field Modal -->
<div class="modal fade" id="fieldModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="SaveField" asp-route-id="@Model.Form.Id">
                <div class="modal-header">
                    <h5 class="modal-title" id="fieldModalTitle">Add Field</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="fieldId" name="Input.FieldId" />

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="label" class="form-label">Label <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="label" name="Input.Label" required maxlength="255" />
                            <div class="form-text">The label displayed to users</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="fieldType" class="form-label">Field Type</label>
                            <select class="form-select" id="fieldType" name="Input.FieldType">
                                @foreach (FieldType ft in Enum.GetValues<FieldType>())
                                {
                                    <option value="@ft">@ft</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="placeholder" class="form-label">Placeholder</label>
                            <input type="text" class="form-control" id="placeholder" name="Input.Placeholder" maxlength="255" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="defaultValue" class="form-label">Default Value</label>
                            <input type="text" class="form-control" id="defaultValue" name="Input.DefaultValue" maxlength="500" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="helpText" class="form-label">Help Text</label>
                        <input type="text" class="form-control" id="helpText" name="Input.HelpText" maxlength="500" />
                        <div class="form-text">Additional instructions shown below the field</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="isRequired" name="Input.IsRequired" value="true" />
                        <label class="form-check-label" for="isRequired">Required field</label>
                    </div>

                    <div id="parentFieldSection" class="mb-3" style="display: none;">
                        <label for="parentFieldId" class="form-label">Parent Field (Cascading)</label>
                        <select class="form-select" id="parentFieldId" name="Input.ParentFieldId">
                            <option value="">-- None --</option>
                            @foreach (var selectField in Model.SelectFields)
                            {
                                <option value="@selectField.Id">@selectField.Label</option>
                            }
                        </select>
                        <div class="form-text">Link to a parent Select field for cascading dropdown behavior</div>
                    </div>

                    <div id="optionsSection" class="mb-3" style="display: none;">
                        <label for="optionsJson" class="form-label">Options (JSON)</label>
                        <textarea class="form-control font-monospace" id="optionsJson" name="Input.OptionsJson" rows="4"></textarea>
                        <div class="form-text" id="optionsHelp">
                            Simple: <code>["Option 1", "Option 2"]</code><br />
                            With values: <code>[{"value": "opt1", "text": "Option 1"}]</code>
                        </div>
                        <div class="form-text text-info" id="cascadingHelp" style="display: none;">
                            For cascading: <code>[{"value": "city1", "text": "City 1", "parentValue": "country1"}]</code>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Field
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the field "<span id="deleteFieldLabel"></span>"?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="DeleteField" asp-route-id="@Model.Form.Id" class="d-inline">
                    <input type="hidden" name="fieldId" id="deleteFieldId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const fieldModalEl = document.getElementById('fieldModal');
            const deleteModalEl = document.getElementById('deleteModal');
            const fieldModal = new bootstrap.Modal(fieldModalEl);
            const deleteModal = new bootstrap.Modal(deleteModalEl);
            const optionsFieldTypes = ['Select', 'Radio', 'Checkbox'];

            function resetForm() {
                document.getElementById('fieldModalTitle').textContent = 'Add Field';
                document.getElementById('fieldId').value = '';
                document.getElementById('label').value = '';
                document.getElementById('fieldType').value = 'Text';
                document.getElementById('placeholder').value = '';
                document.getElementById('defaultValue').value = '';
                document.getElementById('helpText').value = '';
                document.getElementById('isRequired').checked = false;
                document.getElementById('parentFieldId').value = '';
                document.getElementById('optionsJson').value = '';
                toggleOptionsSection();
            }

            function populateForm(data) {
                document.getElementById('fieldModalTitle').textContent = 'Edit Field';
                document.getElementById('fieldId').value = data.Id;
                document.getElementById('label').value = data.Label || '';
                document.getElementById('fieldType').value = data.FieldType;
                document.getElementById('placeholder').value = data.Placeholder || '';
                document.getElementById('defaultValue').value = data.DefaultValue || '';
                document.getElementById('helpText').value = data.HelpText || '';
                document.getElementById('isRequired').checked = data.IsRequired;
                document.getElementById('parentFieldId').value = data.ParentFieldId || '';
                document.getElementById('optionsJson').value = data.OptionsJson || '';
                toggleOptionsSection();
            }

            function toggleOptionsSection() {
                const fieldType = document.getElementById('fieldType').value;
                const optionsSection = document.getElementById('optionsSection');
                const parentFieldSection = document.getElementById('parentFieldSection');

                if (optionsFieldTypes.includes(fieldType)) {
                    optionsSection.style.display = 'block';
                    parentFieldSection.style.display = fieldType === 'Select' ? 'block' : 'none';
                } else {
                    optionsSection.style.display = 'none';
                    parentFieldSection.style.display = 'none';
                }
                toggleCascadingHelp();
            }

            function toggleCascadingHelp() {
                const parentFieldId = document.getElementById('parentFieldId').value;
                document.getElementById('cascadingHelp').style.display = parentFieldId ? 'block' : 'none';
            }

            // Add Field button
            document.getElementById('btnAddField').addEventListener('click', function() {
                resetForm();
                fieldModal.show();
            });

            // Edit Field buttons
            document.querySelectorAll('.btn-edit-field').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const data = JSON.parse(this.getAttribute('data-field'));
                    populateForm(data);
                    fieldModal.show();
                });
            });

            // Delete Field buttons
            document.querySelectorAll('.btn-delete-field').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    document.getElementById('deleteFieldId').value = this.getAttribute('data-field-id');
                    document.getElementById('deleteFieldLabel').textContent = this.getAttribute('data-field-label');
                    deleteModal.show();
                });
            });

            // Field type change
            document.getElementById('fieldType').addEventListener('change', toggleOptionsSection);

            // Parent field change
            document.getElementById('parentFieldId').addEventListener('change', toggleCascadingHelp);
        })();
    </script>
}
