@page "{id:int}"
@model Ufas1Forms.Areas.Admin.Pages.Forms.BuildModel
@using Ufas1Forms.Models
@{
    ViewData["Title"] = $"Build Form: {Model.Form.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Form.Title</h1>
        <a asp-area="Admin" asp-page="./Edit" asp-route-id="@Model.Form.Id" class="text-muted">
            <i class="bi bi-arrow-left"></i> Back to Edit
        </a>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#fieldModal" onclick="openAddModal()">
        <i class="bi bi-plus-lg"></i> Add Field
    </button>
</div>

@if (Model.Fields.Count == 0)
{
    <div class="alert alert-info">
        No fields yet. Click "Add Field" to create your first field.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th style="width: 60px;">Order</th>
                    <th>Label</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Parent Field</th>
                    <th style="width: 80px;">Required</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var field in Model.Fields)
                {
                    <tr>
                        <td>@field.Order</td>
                        <td>@field.Label</td>
                        <td><code>@field.Name</code></td>
                        <td>
                            <span class="badge bg-secondary">@field.FieldType</span>
                        </td>
                        <td>
                            @if (field.ParentFieldId.HasValue)
                            {
                                var parentField = Model.Fields.FirstOrDefault(f => f.Id == field.ParentFieldId);
                                if (parentField != null)
                                {
                                    <span class="badge bg-info">@parentField.Label</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (field.IsRequired)
                            {
                                <span class="badge bg-danger">Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">No</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-primary" title="Edit"
                                        data-bs-toggle="modal" data-bs-target="#fieldModal"
                                        onclick="openEditModal(@field.Id, '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { field.Label, field.FieldType, field.HelpText, field.Placeholder, field.DefaultValue, field.IsRequired, field.OptionsJson, field.ParentFieldId }))')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="MoveUp" asp-route-id="@Model.Form.Id" asp-route-fieldId="@field.Id" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary" title="Move Up" @(field == Model.Fields.First() ? "disabled" : "")>
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="MoveDown" asp-route-id="@Model.Form.Id" asp-route-fieldId="@field.Id" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary" title="Move Down" @(field == Model.Fields.Last() ? "disabled" : "")>
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="DeleteField" asp-route-id="@Model.Form.Id" asp-route-fieldId="@field.Id" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this field?');">
                                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Field Modal -->
<div class="modal fade" id="fieldModal" tabindex="-1" aria-labelledby="fieldModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="fieldForm" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="fieldModalLabel">Add Field</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editFieldId" name="fieldId" value="" />
                    
                    <div class="mb-3">
                        <label for="Label" class="form-label">Label <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Label" name="FieldInput.Label" required maxlength="255" />
                        <div class="form-text">The label displayed to users.</div>
                    </div>

                    <div class="mb-3">
                        <label for="FieldType" class="form-label">Field Type</label>
                        <select class="form-select" id="FieldType" name="FieldInput.FieldType" onchange="toggleOptionsField()">
                            @foreach (FieldType ft in Enum.GetValues<FieldType>())
                            {
                                <option value="@ft">@ft</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="HelpText" class="form-label">Help Text</label>
                        <input type="text" class="form-control" id="HelpText" name="FieldInput.HelpText" maxlength="500" />
                        <div class="form-text">Additional instructions for users.</div>
                    </div>

                    <div class="mb-3">
                        <label for="Placeholder" class="form-label">Placeholder</label>
                        <input type="text" class="form-control" id="Placeholder" name="FieldInput.Placeholder" maxlength="255" />
                    </div>

                    <div class="mb-3">
                        <label for="DefaultValue" class="form-label">Default Value</label>
                        <input type="text" class="form-control" id="DefaultValue" name="FieldInput.DefaultValue" maxlength="500" />
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="IsRequired" name="FieldInput.IsRequired" value="true" />
                        <label class="form-check-label" for="IsRequired">Required</label>
                    </div>

                    <div class="mb-3" id="parentFieldContainer" style="display: none;">
                        <label for="ParentFieldId" class="form-label">Parent Field (Cascading)</label>
                        <select class="form-select" id="ParentFieldId" name="FieldInput.ParentFieldId">
                            <option value="">-- None --</option>
                            @foreach (var selectField in Model.Fields.Where(f => f.FieldType == FieldType.Select))
                            {
                                <option value="@selectField.Id">@selectField.Label</option>
                            }
                        </select>
                        <div class="form-text">
                            Select a parent field for cascading dropdown. Child options will filter based on parent selection.
                        </div>
                    </div>

                    <div class="mb-3" id="optionsContainer" style="display: none;">
                        <label for="OptionsJson" class="form-label">Options (JSON)</label>
                        <textarea class="form-control" id="OptionsJson" name="FieldInput.OptionsJson" rows="4"></textarea>
                        <div class="form-text" id="optionsHelpText">
                            Enter options as JSON array, e.g.: <code>["Option 1", "Option 2", "Option 3"]</code><br/>
                            Or with values: <code>[{"value": "opt1", "text": "Option 1"}, {"value": "opt2", "text": "Option 2"}]</code>
                        </div>
                        <div class="form-text text-info" id="optionsHelpTextCascading" style="display: none;">
                            For cascading dropdowns, include <code>parentValue</code>:<br/>
                            <code>[{"value": "city1", "text": "City 1", "parentValue": "state1"}, {"value": "city2", "text": "City 2", "parentValue": "state1"}]</code>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Field</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const formId = @Model.Form.Id;
        const optionsFieldTypes = ['Select', 'Radio', 'Checkbox'];
        
        function openAddModal() {
            document.getElementById('fieldModalLabel').textContent = 'Add Field';
            document.getElementById('fieldForm').action = '?handler=AddField&id=' + formId;
            document.getElementById('editFieldId').value = '';
            document.getElementById('Label').value = '';
            document.getElementById('FieldType').value = 'Text';
            document.getElementById('HelpText').value = '';
            document.getElementById('Placeholder').value = '';
            document.getElementById('DefaultValue').value = '';
            document.getElementById('IsRequired').checked = false;
            document.getElementById('OptionsJson').value = '';
            document.getElementById('ParentFieldId').value = '';
            toggleOptionsField();
        }
        
        function openEditModal(fieldId, fieldDataJson) {
            const fieldData = JSON.parse(fieldDataJson);
            document.getElementById('fieldModalLabel').textContent = 'Edit Field';
            document.getElementById('fieldForm').action = '?handler=EditField&id=' + formId + '&fieldId=' + fieldId;
            document.getElementById('editFieldId').value = fieldId;
            document.getElementById('Label').value = fieldData.Label || '';
            document.getElementById('FieldType').value = fieldData.FieldType;
            document.getElementById('HelpText').value = fieldData.HelpText || '';
            document.getElementById('Placeholder').value = fieldData.Placeholder || '';
            document.getElementById('DefaultValue').value = fieldData.DefaultValue || '';
            document.getElementById('IsRequired').checked = fieldData.IsRequired;
            document.getElementById('OptionsJson').value = fieldData.OptionsJson || '';
            document.getElementById('ParentFieldId').value = fieldData.ParentFieldId || '';
            toggleOptionsField();
        }
        
        function toggleOptionsField() {
            const fieldType = document.getElementById('FieldType').value;
            const optionsContainer = document.getElementById('optionsContainer');
            const parentFieldContainer = document.getElementById('parentFieldContainer');
            const parentFieldId = document.getElementById('ParentFieldId').value;
            const optionsHelpTextCascading = document.getElementById('optionsHelpTextCascading');
            
            if (optionsFieldTypes.includes(fieldType)) {
                optionsContainer.style.display = 'block';
                if (fieldType === 'Select') {
                    parentFieldContainer.style.display = 'block';
                } else {
                    parentFieldContainer.style.display = 'none';
                    document.getElementById('ParentFieldId').value = '';
                }
            } else {
                optionsContainer.style.display = 'none';
                parentFieldContainer.style.display = 'none';
                document.getElementById('ParentFieldId').value = '';
            }
            
            // Show cascading help text when parent field is selected
            if (parentFieldId) {
                optionsHelpTextCascading.style.display = 'block';
            } else {
                optionsHelpTextCascading.style.display = 'none';
            }
        }
        
        document.getElementById('ParentFieldId').addEventListener('change', toggleOptionsField);
        
        document.addEventListener('DOMContentLoaded', function() {
            toggleOptionsField();
        });
    </script>
}
