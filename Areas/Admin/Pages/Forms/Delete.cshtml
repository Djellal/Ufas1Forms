@page "{id:int}"
@model Ufas1Forms.Areas.Admin.Pages.Forms.DeleteModel
@{
    ViewData["Title"] = "Delete Form";
}

<div class="container">
    <h1 class="text-danger">Delete Form</h1>

    <div class="alert alert-warning" role="alert">
        <strong>Warning!</strong> This action cannot be undone. All form fields and submissions will be permanently deleted.
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Form Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Form.Title</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(Model.Form.Description ?? "N/A")</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.Form.Type</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Form.Status</dd>

                <dt class="col-sm-3">Slug</dt>
                <dd class="col-sm-9">@Model.Form.Slug</dd>

                <dt class="col-sm-3">Fields</dt>
                <dd class="col-sm-9">@Model.FieldCount</dd>

                <dt class="col-sm-3">Submissions</dt>
                <dd class="col-sm-9">@Model.SubmissionCount</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.Form.CreatedAt.ToString("g")</dd>
            </dl>
        </div>
        <div class="card-footer">
            <form method="post">
                <input type="hidden" asp-for="Form.Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
