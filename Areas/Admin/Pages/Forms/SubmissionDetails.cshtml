@page "{formId:int}/{submissionId:int}"
@model Ufas1Forms.Areas.Admin.Pages.Forms.SubmissionDetailsModel
@{
    ViewData["Title"] = $"Submission #{Model.Submission.Id} - {Model.Form.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Submission Details</h1>
        <p class="text-muted mb-0">Form: @Model.Form.Title</p>
    </div>
    <div>
        <a asp-page="Submissions" asp-route-id="@Model.Form.Id" class="btn btn-outline-secondary me-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Submissions
        </a>
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash me-1"></i>Delete
        </button>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Submission Metadata</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.Submission.Id</dd>

                    <dt class="col-sm-4">Submitted At</dt>
                    <dd class="col-sm-8">@Model.Submission.SubmittedAt.ToString("MMM dd, yyyy HH:mm:ss")</dd>

                    <dt class="col-sm-4">Submitted By</dt>
                    <dd class="col-sm-8">@(Model.SubmittedByEmail ?? "Anonymous")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">IP Address</dt>
                    <dd class="col-sm-8">@(Model.Submission.IpAddress ?? "N/A")</dd>

                    <dt class="col-sm-4">User Agent</dt>
                    <dd class="col-sm-8"><small class="text-muted">@(Model.Submission.UserAgent ?? "N/A")</small></dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var statusClass = Model.Submission.Status switch
                            {
                                SubmissionStatus.Completed => "bg-success",
                                SubmissionStatus.Partial => "bg-warning text-dark",
                                SubmissionStatus.Deleted => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@Model.Submission.Status</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Answers</h5>
    </div>
    <div class="card-body">
        @if (!Model.Answers.Any())
        {
            <p class="text-muted mb-0">No answers recorded.</p>
        }
        else
        {
            <dl class="row mb-0">
                @foreach (var answer in Model.Answers)
                {
                    <dt class="col-sm-3">@answer.Label</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(answer.Value) ? "-" : answer.Value)</dd>
                }
            </dl>
        }
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this submission? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" class="d-inline">
                    <input type="hidden" name="formId" value="@Model.Form.Id" />
                    <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
