@page
@model Ufas1Forms.Areas.Admin.Pages.Forms.IndexModel
@{
    ViewData["Title"] = "Forms Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Forms</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Create New Form
    </a>
</div>

@if (!Model.Forms.Any())
{
    <div class="alert alert-info">
        No forms found. <a asp-page="Create">Create your first form</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Submissions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var form in Model.Forms)
                {
                    <tr>
                        <td>@form.Title</td>
                        <td>
                            <span class="badge bg-secondary">@form.Type</span>
                        </td>
                        <td>
                            @{
                                var statusClass = form.Status switch
                                {
                                    Ufas1Forms.Models.FormStatus.Published => "bg-success",
                                    Ufas1Forms.Models.FormStatus.Draft => "bg-warning text-dark",
                                    Ufas1Forms.Models.FormStatus.Archived => "bg-secondary",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass">@form.Status</span>
                        </td>
                        <td>@form.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>@form.SubmissionCount</td>
                        <td>
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-page="Edit" asp-route-id="@form.Id" class="btn btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Build" asp-route-id="@form.Id" class="btn btn-outline-secondary" title="Build">
                                    <i class="bi bi-tools"></i>
                                </a>
                                <a asp-page="Submissions" asp-route-id="@form.Id" class="btn btn-outline-info" title="View Submissions">
                                    <i class="bi bi-list-ul"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger" title="Delete"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-form-id="@form.Id" data-form-title="@form.Title">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the form "<span id="deleteFormTitle"></span>"?
                This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" class="d-inline">
                    <input type="hidden" name="id" id="deleteFormId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var formId = button.getAttribute('data-form-id');
            var formTitle = button.getAttribute('data-form-title');
            document.getElementById('deleteFormId').value = formId;
            document.getElementById('deleteFormTitle').textContent = formTitle;
        });
    </script>
}
