@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-3 col-lg-2">
        <nav class="navbar navbar-expand-md navbar-light bg-light rounded mb-3 mb-md-0">
            <div class="container-fluid flex-md-column align-items-stretch">
                <span class="navbar-brand d-md-none">Admin Menu</span>
                <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" 
                        data-bs-target="#adminSidebar" aria-controls="adminSidebar" 
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-md-block" id="adminSidebar">
                    <ul class="nav nav-pills flex-column w-100">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-2"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-page="/Forms/Index">
                                <i class="bi bi-file-earmark-text me-2"></i>Forms
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
    <div class="col-md-9 col-lg-10">
        @RenderBody()
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
