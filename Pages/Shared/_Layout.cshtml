<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ufas1Forms</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ufas1Forms.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg shadow-sm" style="background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%);">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center text-white fw-bold" asp-area="" asp-page="/Index">
                    <i class="bi bi-ui-checks-grid me-2 fs-4"></i>
                    <span>Ufas1Forms</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list text-white fs-3"></i>
                </button>
                <div class="navbar-collapse collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3 nav-hover" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3 nav-hover" asp-area="" asp-page="/Forms/Index">
                                <i class="bi bi-file-earmark-text me-1"></i> Forms
                            </a>
                        </li>
                        @if (User.IsInRole("admin") || User.IsInRole("facadmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white-50 px-3 nav-hover" asp-area="Admin" asp-page="/Forms/Index">
                                    <i class="bi bi-gear me-1"></i> Admin
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-white-50 px-3 nav-hover" asp-area="" asp-page="/Privacy">
                                <i class="bi bi-shield-check me-1"></i> Privacy
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto py-4" style="background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%);">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <span class="text-white-50">
                        <i class="bi bi-c-circle me-1"></i> 2026 Ufas1Forms - University Forms Management
                    </span>
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a class="text-white-50 text-decoration-none me-3" asp-area="" asp-page="/Privacy">
                        <i class="bi bi-shield-lock me-1"></i> Privacy
                    </a>
                    <a class="text-white-50 text-decoration-none" href="https://github.com/Djellal/Ufas1Forms" target="_blank">
                        <i class="bi bi-github me-1"></i> GitHub
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
