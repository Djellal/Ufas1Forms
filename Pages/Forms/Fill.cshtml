@page "{slug}"
@using Ufas1Forms.Helpers
@using Ufas1Forms.Models
@model Ufas1Forms.Pages.Forms.FillModel
@{
    ViewData["Title"] = Model.Form?.Title ?? "Form";
}

<div class="container py-4">
    @if (Model.Form == null)
    {
        <div class="alert alert-danger">Form not found.</div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">@Model.Form.Title</h3>
                        @if (!string.IsNullOrEmpty(Model.Form.Description))
                        {
                            <p class="text-muted mb-0 mt-2">@Model.Form.Description</p>
                        }
                    </div>
                    <div class="card-body">
                        <form method="post">
                            @foreach (var field in Model.Form.Fields)
                            {
                                var fieldId = $"field_{field.Id}";
                                var hasError = !ViewData.ModelState.IsValid && 
                                    (ViewData.ModelState.ContainsKey($"Answers[{field.Name}]") || 
                                     ViewData.ModelState.ContainsKey($"CheckboxAnswers[{field.Name}]"));
                                
                                @if (field.FieldType == FieldType.Hidden)
                                {
                                    <input type="hidden" name="Answers[@field.Name]" value="@field.DefaultValue" />
                                }
                                else
                                {
                                    <div class="mb-3">
                                        @if (field.FieldType != FieldType.Checkbox && field.FieldType != FieldType.Radio)
                                        {
                                            <label for="@fieldId" class="form-label">
                                                @field.Label
                                                @if (field.IsRequired)
                                                {
                                                    <span class="text-danger">*</span>
                                                }
                                            </label>
                                        }

                                        @switch (field.FieldType)
                                        {
                                            case FieldType.Text:
                                            case FieldType.Email:
                                            case FieldType.Number:
                                            case FieldType.Phone:
                                            case FieldType.Url:
                                            case FieldType.Password:
                                                var inputType = field.FieldType switch
                                                {
                                                    FieldType.Email => "email",
                                                    FieldType.Number => "number",
                                                    FieldType.Phone => "tel",
                                                    FieldType.Url => "url",
                                                    FieldType.Password => "password",
                                                    _ => "text"
                                                };
                                                <input type="@inputType" 
                                                       id="@fieldId" 
                                                       name="Answers[@field.Name]" 
                                                       class="form-control @(hasError ? "is-invalid" : "")"
                                                       placeholder="@field.Placeholder"
                                                       value="@(Model.Answers.GetValueOrDefault(field.Name) ?? field.DefaultValue)"
                                                       @(field.IsRequired ? "required" : "") />
                                                break;

                                            case FieldType.Textarea:
                                                <textarea id="@fieldId" 
                                                          name="Answers[@field.Name]" 
                                                          class="form-control @(hasError ? "is-invalid" : "")"
                                                          placeholder="@field.Placeholder"
                                                          rows="4"
                                                          @(field.IsRequired ? "required" : "")>@(Model.Answers.GetValueOrDefault(field.Name) ?? field.DefaultValue)</textarea>
                                                break;

                                            case FieldType.Select:
                                                var selectOptions = OptionsJsonParser.Parse(field.OptionsJson);
                                                <select id="@fieldId" 
                                                        name="Answers[@field.Name]" 
                                                        class="form-select @(hasError ? "is-invalid" : "")"
                                                        @(field.IsRequired ? "required" : "")>
                                                    <option value="">@(field.Placeholder ?? "Select an option...")</option>
                                                    @foreach (var opt in selectOptions)
                                                    {
                                                        var isSelected = Model.Answers.GetValueOrDefault(field.Name) == opt.Value || 
                                                                        (string.IsNullOrEmpty(Model.Answers.GetValueOrDefault(field.Name)) && field.DefaultValue == opt.Value);
                                                        <option value="@opt.Value" selected="@isSelected">@opt.Text</option>
                                                    }
                                                </select>
                                                break;

                                            case FieldType.Radio:
                                                var radioOptions = OptionsJsonParser.Parse(field.OptionsJson);
                                                <fieldset>
                                                    <legend class="form-label">
                                                        @field.Label
                                                        @if (field.IsRequired)
                                                        {
                                                            <span class="text-danger">*</span>
                                                        }
                                                    </legend>
                                                    @foreach (var opt in radioOptions)
                                                    {
                                                        var radioId = $"{fieldId}_{opt.Value}";
                                                        var isChecked = Model.Answers.GetValueOrDefault(field.Name) == opt.Value || 
                                                                       (string.IsNullOrEmpty(Model.Answers.GetValueOrDefault(field.Name)) && field.DefaultValue == opt.Value);
                                                        <div class="form-check">
                                                            <input type="radio" 
                                                                   id="@radioId" 
                                                                   name="Answers[@field.Name]" 
                                                                   value="@opt.Value"
                                                                   class="form-check-input @(hasError ? "is-invalid" : "")"
                                                                   checked="@isChecked"
                                                                   @(field.IsRequired ? "required" : "") />
                                                            <label class="form-check-label" for="@radioId">@opt.Text</label>
                                                        </div>
                                                    }
                                                </fieldset>
                                                break;

                                            case FieldType.Checkbox:
                                                var checkboxOptions = OptionsJsonParser.Parse(field.OptionsJson);
                                                <fieldset>
                                                    <legend class="form-label">
                                                        @field.Label
                                                        @if (field.IsRequired)
                                                        {
                                                            <span class="text-danger">*</span>
                                                        }
                                                    </legend>
                                                    @foreach (var opt in checkboxOptions)
                                                    {
                                                        var checkId = $"{fieldId}_{opt.Value}";
                                                        var isChecked = Model.CheckboxAnswers.GetValueOrDefault(field.Name)?.Contains(opt.Value) == true;
                                                        <div class="form-check">
                                                            <input type="checkbox" 
                                                                   id="@checkId" 
                                                                   name="CheckboxAnswers[@field.Name]" 
                                                                   value="@opt.Value"
                                                                   class="form-check-input @(hasError ? "is-invalid" : "")"
                                                                   checked="@isChecked" />
                                                            <label class="form-check-label" for="@checkId">@opt.Text</label>
                                                        </div>
                                                    }
                                                </fieldset>
                                                break;

                                            case FieldType.Date:
                                                <input type="date" 
                                                       id="@fieldId" 
                                                       name="Answers[@field.Name]" 
                                                       class="form-control @(hasError ? "is-invalid" : "")"
                                                       value="@(Model.Answers.GetValueOrDefault(field.Name) ?? field.DefaultValue)"
                                                       @(field.IsRequired ? "required" : "") />
                                                break;

                                            case FieldType.Time:
                                                <input type="time" 
                                                       id="@fieldId" 
                                                       name="Answers[@field.Name]" 
                                                       class="form-control @(hasError ? "is-invalid" : "")"
                                                       value="@(Model.Answers.GetValueOrDefault(field.Name) ?? field.DefaultValue)"
                                                       @(field.IsRequired ? "required" : "") />
                                                break;

                                            case FieldType.File:
                                                <input type="file" 
                                                       id="@fieldId" 
                                                       name="Answers[@field.Name]" 
                                                       class="form-control @(hasError ? "is-invalid" : "")"
                                                       @(field.IsRequired ? "required" : "") />
                                                break;
                                        }

                                        @if (!string.IsNullOrEmpty(field.HelpText))
                                        {
                                            <div class="form-text">@field.HelpText</div>
                                        }

                                        @if (hasError)
                                        {
                                            <div class="invalid-feedback d-block">
                                                @if (field.FieldType == FieldType.Checkbox)
                                                {
                                                    @ViewData.ModelState[$"CheckboxAnswers[{field.Name}]"]?.Errors.FirstOrDefault()?.ErrorMessage
                                                }
                                                else
                                                {
                                                    @ViewData.ModelState[$"Answers[{field.Name}]"]?.Errors.FirstOrDefault()?.ErrorMessage
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
