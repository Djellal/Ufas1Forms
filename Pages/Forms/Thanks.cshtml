@page "{slug}"
@model Ufas1Forms.Pages.Forms.ThanksModel
@{
    ViewData["Title"] = "Thank You";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="card">
                <div class="card-body py-5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill text-success mb-4" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                    <h2 class="mb-3">Thank You!</h2>
                    <p class="text-muted mb-4">
                        Your response to <strong>@Model.Form?.Title</strong> has been submitted successfully.
                    </p>
                    <a asp-page="./Index" class="btn btn-primary">
                        Back to Forms
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
